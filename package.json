{
  "name": "ai-platform-frontend-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright E2E, API and smoke test suite for the AI Automation Platform frontend.",
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:critical": "playwright test --grep @critical",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:regression": "playwright test --grep @regression",
    "test:e2e:api": "playwright test --grep @api",
    "test:e2e:prod-smoke": "E2E_ENVIRONMENT=production-smoke playwright test --grep @production-safe --project=chromium",
    "test:e2e:no-real-provider": "playwright test --grep-invert @real-provider",
    "test:e2e:accessibility": "playwright test --grep @accessibility",
    "test:e2e:visual": "playwright test --grep @visual --project=chromium",
    "test:e2e:visual:update": "playwright test --grep @visual --project=chromium --update-snapshots",
    "test:list": "playwright test --list",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.49.1",
    "@types/node": "^22.20.1",
    "typescript": "5.7.3"
  }
}
